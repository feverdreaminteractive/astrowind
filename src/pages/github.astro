---
import Layout from '../layouts/Layout.astro';
import { SKILLS_CONFIG } from '../consts';

// GitHub API call to fetch repositories
const username = 'ryanclayton';
const githubResponse = await fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=20`);
const repos = githubResponse.ok ? await githubResponse.json() : [];

// Fetch user profile
const userResponse = await fetch(`https://api.github.com/users/${username}`);
const user = userResponse.ok ? await userResponse.json() : {};

// Filter for important repositories and sort by stars/activity
const importantRepos = repos.filter((repo: any) => !repo.fork && !repo.archived)
  .sort((a: any, b: any) => (b.stargazers_count + b.forks_count) - (a.stargazers_count + a.forks_count))
  .slice(0, 12);
---

<Layout showNavigation={true}>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-black to-blue-900/20"></div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <!-- Header Section -->
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-5xl font-light text-white mb-4 flex items-center justify-center">
          <i class="fab fa-github text-5xl mr-4"></i>
          Open Source Projects
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto font-light">
          Explore my contributions to the open source community and personal projects on GitHub.
        </p>
      </div>

      <!-- GitHub Profile Header -->
      <div class="bg-black/60 backdrop-blur-md border border-white/10 p-8 mb-8">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
          <img
            src={user.avatar_url}
            alt={`${user.name} avatar`}
            class="w-24 h-24 shadow-lg"
          />
          <div class="flex-1">
            <h2 class="text-3xl font-light text-white mb-2">
              {user.name || user.login}
            </h2>
            <p class="text-lg text-gray-400 mb-1">@{user.login}</p>
            {user.bio && (
              <p class="text-gray-400 mb-4">{user.bio}</p>
            )}
            <div class="flex flex-wrap gap-4 text-sm text-gray-400">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                </svg>
                {user.followers} followers
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                </svg>
                {user.following} following
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
                </svg>
                {user.public_repos} repositories
              </span>
            </div>
          </div>
          <a
            href={user.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-white text-black hover:bg-gray-100 transition-all hover:scale-105 hover:shadow-lg hover:shadow-white/20 font-medium"
          >
            View on GitHub
          </a>
        </div>
      </div>

      <!-- Repositories Grid -->
      <div class="mb-8">
        <h2 class="text-2xl font-light text-white mb-6">
          Featured Projects
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {importantRepos.map((repo: any) => (
            <a href={repo.html_url} target="_blank" rel="noopener noreferrer"
               class="block bg-black/60 backdrop-blur-md border border-white/10 p-6 hover:border-white/30 transition-all hover:scale-105">
              <div class="flex items-start justify-between mb-4">
                <h3 class="font-light text-lg text-white truncate">
                  <i class="fas fa-folder mr-2 text-purple-400"></i>
                  {repo.name}
                </h3>
                {repo.visibility === 'public' && (
                  <span class="text-xs px-2 py-1 bg-white/10 text-gray-400">
                    public
                  </span>
                )}
              </div>

              {repo.description && (
                <p class="text-sm text-gray-400 mb-4 line-clamp-3 font-light">
                  {repo.description}
                </p>
              )}

              <div class="flex items-center justify-between text-sm text-gray-500">
                <div class="flex items-center gap-4">
                  {repo.language && (
                    <span class="flex items-center gap-1">
                      <span class="w-3 h-3 bg-purple-400"></span>
                      {repo.language}
                    </span>
                  )}
                  {repo.stargazers_count > 0 && (
                    <span class="flex items-center gap-1">
                      <i class="fas fa-star mr-1"></i>
                      {repo.stargazers_count}
                    </span>
                  )}
                  {repo.forks_count > 0 && (
                    <span class="flex items-center gap-1">
                      <i class="fas fa-code-branch mr-1"></i>
                      {repo.forks_count}
                    </span>
                  )}
                </div>
                <span class="text-xs">
                  Updated {new Date(repo.updated_at).toLocaleDateString()}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Activity Stats -->
      <div class="bg-black/60 backdrop-blur-md border border-white/10 p-8 mb-8">
        <h3 class="text-xl font-light text-white mb-4">
          GitHub Activity
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="text-center">
            <div class="text-2xl font-light text-white">
              {repos.length}
            </div>
            <div class="text-sm text-gray-400 font-light">Total Repos</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-light text-white">
              {repos.reduce((acc: number, repo: any) => acc + repo.stargazers_count, 0)}
            </div>
            <div class="text-sm text-gray-400 font-light">Total Stars</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-light text-white">
              {repos.reduce((acc: number, repo: any) => acc + repo.forks_count, 0)}
            </div>
            <div class="text-sm text-gray-400 font-light">Total Forks</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-light text-white">
              {repos.filter((repo: any) => !repo.fork).length}
            </div>
            <div class="text-sm text-gray-400 font-light">Original Repos</div>
          </div>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="text-center">
        <a
          href="https://github.com/ryanclayton"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 text-base font-medium text-black bg-white hover:bg-gray-100 transition-all hover:scale-105 hover:shadow-lg hover:shadow-white/20"
        >
          <i class="fab fa-github mr-2"></i>
          View Full GitHub Profile
        </a>
      </div>

    </div>
  </main>
</Layout>

<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
  /* Grid pattern background */
  .bg-grid-pattern {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

</style>