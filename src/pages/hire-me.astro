---
import Layout from '../layouts/Layout.astro';
---

<Layout showNavigation={true}>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-black to-blue-900/20"></div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Header Section -->
      <div class="text-center mb-12 animate-fade-in">
        <h1 class="text-4xl lg:text-5xl font-light text-white mb-4 flex items-center justify-center">
          <svg class="w-10 h-10 mr-4 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path>
          </svg>
          Let's Talk
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto font-light">
          Ready to bring your vision to life? I'm available for new projects and excited to discuss how we can work together to create something amazing.
        </p>
      </div>

      <!-- Contact Form Section -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8">
        <!-- Success Message (hidden by default) -->
        <div id="success-message" class="hidden mb-6 p-4 bg-green-900/20 border border-green-500/30 rounded-lg">
          <p class="text-green-400 text-center">Thank you! Your message has been sent successfully. I'll get back to you soon.</p>
        </div>

        <!-- Error Message (hidden by default) -->
        <div id="error-message" class="hidden mb-6 p-4 bg-red-900/20 border border-red-500/30 rounded-lg">
          <p class="text-red-400 text-center">Something went wrong. Please try again or email me directly at ryanclayton78@gmail.com</p>
        </div>

        <form
          name="hire-me"
          method="POST"
          action="/hire-me?success=true"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-6"
        >
          <!-- Hidden fields for Netlify -->
          <input type="hidden" name="form-name" value="hire-me" />
          <div class="hidden">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </div>

          <!-- Name Field -->
          <div>
            <label for="name" class="block text-sm font-light text-white mb-2">
              Full Name *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 border border-white/20 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 bg-black/40 text-white placeholder-gray-500"
              placeholder="Your full name"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label for="email" class="block text-sm font-light text-white mb-2">
              Email Address *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-white/20 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 bg-black/40 text-white placeholder-gray-500"
              placeholder="your.email@example.com"
            />
          </div>

          <!-- Subject Field -->
          <div>
            <label for="subject" class="block text-sm font-light text-white mb-2">
              Subject *
            </label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full px-4 py-3 border border-white/20 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 bg-black/40 text-white"
            >
              <option value="" class="bg-black">Select a subject</option>
              <option value="job-opportunity" class="bg-black">Job Opportunity</option>
              <option value="collaboration" class="bg-black">Project Collaboration</option>
              <option value="consulting" class="bg-black">Consulting Inquiry</option>
              <option value="general" class="bg-black">General Question</option>
              <option value="other" class="bg-black">Other</option>
            </select>
          </div>

          <!-- Message Field -->
          <div>
            <label for="message" class="block text-sm font-light text-white mb-2">
              Message *
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full px-4 py-3 border border-white/20 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 bg-black/40 text-white placeholder-gray-500 resize-vertical"
              placeholder="Tell me about your project, opportunity, or question..."
            ></textarea>
          </div>

          <!-- Budget Field (Optional) -->
          <div>
            <label for="budget" class="block text-sm font-light text-white mb-2">
              Project Budget (Optional)
            </label>
            <select
              id="budget"
              name="budget"
              class="w-full px-4 py-3 border border-white/20 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 bg-black/40 text-white"
            >
              <option value="" class="bg-black">Not specified</option>
              <option value="under-5k" class="bg-black">Under $5,000</option>
              <option value="5k-15k" class="bg-black">$5,000 - $15,000</option>
              <option value="15k-50k" class="bg-black">$15,000 - $50,000</option>
              <option value="50k-plus" class="bg-black">$50,000+</option>
            </select>
          </div>

          <!-- Timeline Field (Optional) -->
          <div>
            <label for="timeline" class="block text-sm font-light text-white mb-2">
              Project Timeline (Optional)
            </label>
            <select
              id="timeline"
              name="timeline"
              class="w-full px-4 py-3 border border-white/20 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 bg-black/40 text-white"
            >
              <option value="" class="bg-black">Not specified</option>
              <option value="asap" class="bg-black">ASAP</option>
              <option value="1-month" class="bg-black">Within 1 month</option>
              <option value="1-3-months" class="bg-black">1-3 months</option>
              <option value="3-6-months" class="bg-black">3-6 months</option>
              <option value="6-months-plus" class="bg-black">6+ months</option>
            </select>
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <button
              type="submit"
              class="w-full bg-white text-black font-medium py-4 px-6 rounded-lg hover:bg-gray-100 transition-all hover:scale-105 hover:shadow-lg hover:shadow-white/20 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black"
            >
              <span class="flex items-center justify-center">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
                Send Message
              </span>
            </button>
          </div>
        </form>
      </div>

    </div>
  </main>
</Layout>

<style>
  /* Grid pattern background */
  .bg-grid-pattern {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
  }
</style>

<script>
  // Check for success message in URL
  document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);

    if (urlParams.get('success') === 'true') {
      // Show success message
      const successMessage = document.getElementById('success-message');
      const form = document.querySelector('form[name="hire-me"]');
      if (successMessage) {
        successMessage.classList.remove('hidden');
      }
      if (form) {
        form.style.display = 'none';
      }

      // Clean up URL
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, document.title, cleanUrl);
    }
  });

  // Form submission handling
  document.querySelector('form[name="hire-me"]')?.addEventListener('submit', function(e) {
    const submitBtn = e.target.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.innerHTML = `
        <span class="flex items-center justify-center">
          <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-black" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Sending...
        </span>
      `;
      submitBtn.disabled = true;
    }
  });
</script>