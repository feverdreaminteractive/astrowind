---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
---

<Layout showNavigation={true}>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-black to-blue-900/20"></div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <!-- About Header -->
      <div class="text-center mb-12 animate-fade-in">
        <h1 class="text-4xl lg:text-5xl font-light text-white mb-4">
          About
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto font-light">
          Who I am, what this site is, and 12+ years of building the platforms in between.
        </p>
      </div>

      <!-- What This Site Is -->
      <div class="animate-fade-in bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-2xl font-light text-white mb-4 flex items-center">
          <svg class="w-6 h-6 mr-3 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          What This Site Is
        </h2>
        <p class="text-gray-300 font-light leading-relaxed mb-4">
          This isn't just a portfolio — it's a live workbench. Every interactive tool below is a real, working
          integration built with Claude, not a mockup: Netlify Functions calling the Claude API with web search,
          structured outputs, and tool use against actual infrastructure. I build them here first because it's the
          fastest way to find out what's genuinely useful versus what just sounds good in a deck.
        </p>
        <p class="text-gray-400 font-light leading-relaxed mb-6">
          Poke around — each one is fully functional, not a screenshot.
        </p>

        <div class="grid sm:grid-cols-2 gap-4">
          {[
            {
              name: 'AI Builder',
              href: '/builder',
              description: 'Generate a working website from a prompt, live in the browser.',
              icon: 'M13 3L4 14h6l-1 7 9-11h-6l1-7z',
            },
            {
              name: 'Shader Lab',
              href: '/shader-lab',
              description: 'Write and preview GLSL shaders with AI-assisted generation.',
              icon: 'M8 9l-4 3 4 3M16 9l4 3-4 3',
            },
            {
              name: 'Stack Auditor',
              href: '/stack-audit',
              description: "Scan any site's martech stack and get an AI-powered audit.",
              icon: 'search',
            },
            {
              name: 'AEO Checker',
              href: '/aeo-check',
              description: 'See what AI answer engines actually say about a brand.',
              icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
            },
          ].map((tool) => (
            <a
              href={tool.href}
              class="flex items-start gap-3 p-4 rounded-lg border border-white/10 hover:border-white/20 hover:bg-white/5 transition-colors"
            >
              <span class="mt-0.5 flex items-center justify-center w-9 h-9 rounded-lg bg-purple-500/15 text-purple-400 shrink-0">
                {tool.icon === 'search' ? (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7" stroke-width="2"></circle>
                    <path stroke-linecap="round" stroke-width="2" d="M21 21l-4.35-4.35"></path>
                  </svg>
                ) : (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tool.icon}></path>
                  </svg>
                )}
              </span>
              <span>
                <span class="block text-white">{tool.name}</span>
                <span class="block text-sm text-gray-500 mt-0.5 leading-snug">{tool.description}</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- Experience Header -->
      <div class="text-center mb-8 animate-fade-in">
        <h2 class="text-2xl font-light text-white mb-2">Professional Experience</h2>
        <p class="text-gray-400 max-w-2xl mx-auto font-light">
          12+ years in web development management, leading technical teams, and building scalable platforms across
          fintech, legaltech, and AI-powered solutions.
        </p>
      </div>

      <!-- Experience Timeline -->
      <div class="animate-slide-up bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-2xl font-light text-white mb-8 flex items-center">
          <svg class="w-6 h-6 mr-3 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
          </svg>
          Career Timeline
        </h2>

        <div class="space-y-8">
          <!-- Current Position -->
          <div class="relative pl-8">
            <div class="absolute left-0 top-0 w-4 h-4 bg-purple-500 rounded-full"></div>
            <div class="absolute left-2 top-4 w-0.5 h-full bg-white/10"></div>

            <div class="bg-gradient-to-r from-purple-900/20 to-blue-900/20 rounded-lg p-6 border border-white/10">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <h3 class="text-xl font-normal text-white">Senior Web Development Manager</h3>
                <span class="text-sm font-light text-purple-400 bg-purple-900/30 px-3 py-1 rounded-full">2020 - Present</span>
              </div>
              <p class="text-gray-400 font-light mb-3">Leading Technical Innovation & Team Management</p>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Led enterprise rebrand across 7 web properties with zero downtime
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Architected modern Jamstack solutions using Vue.js, React, and Astro
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Integrated Claude AI for conversational business intelligence and automation
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Managed technical teams and cross-functional project delivery
                </li>
              </ul>
            </div>
          </div>

          <!-- Previous Position -->
          <div class="relative pl-8">
            <div class="absolute left-0 top-0 w-4 h-4 bg-gray-600 rounded-full"></div>
            <div class="absolute left-2 top-4 w-0.5 h-full bg-white/10"></div>

            <div class="bg-white/5 rounded-lg p-6 border border-white/10">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <h3 class="text-lg font-normal text-white">Full Stack Developer</h3>
                <span class="text-sm font-light text-gray-400 bg-white/10 px-3 py-1 rounded-full">2018 - 2020</span>
              </div>
              <p class="text-gray-400 font-light mb-3">Fintech & Legaltech Platform Development</p>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Built scalable web applications with Node.js and modern frontend frameworks
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Implemented CI/CD pipelines and automated deployment processes
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Developed marketing automation and CRM integrations
                </li>
              </ul>
            </div>
          </div>

          <!-- Earlier Experience -->
          <div class="relative pl-8">
            <div class="absolute left-0 top-0 w-4 h-4 bg-gray-300 rounded-full"></div>

            <div class="bg-white/5 rounded-lg p-6 border border-white/10">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <h3 class="text-lg font-normal text-white">Web Developer</h3>
                <span class="text-sm font-light text-gray-400 bg-white/10 px-3 py-1 rounded-full">2015 - 2018</span>
              </div>
              <p class="text-gray-400 font-light mb-3">Foundation Building & Core Development</p>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Mastered JavaScript, HTML5/CSS3, and modern web development practices
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Built responsive websites and web applications for various industries
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Gained expertise in CMS platforms and e-commerce solutions
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Key Achievements -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-2xl font-light text-white mb-8 flex items-center">
          <svg class="w-6 h-6 mr-3 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
          </svg>
          Key Achievements
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="text-center p-4">
            <div class="text-3xl font-light text-purple-400 mb-2">7</div>
            <p class="text-sm text-gray-400">Web Properties Rebranded</p>
          </div>
          <div class="text-center p-4">
            <div class="text-3xl font-light text-purple-400 mb-2">0</div>
            <p class="text-sm text-gray-400">Downtime During Migration</p>
          </div>
          <div class="text-center p-4">
            <div class="text-3xl font-light text-purple-400 mb-2">12+</div>
            <p class="text-sm text-gray-400">Years Experience</p>
          </div>
        </div>
      </div>

      <!-- Contact & Newsletter -->
      <div class="w-full max-w-2xl mx-auto">
        <Newsletter />
      </div>

    </div>
  </main>
</Layout>