---
import Layout from '../layouts/Layout.astro';
---

<Layout showNavigation={true}>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-black to-blue-900/20"></div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <!-- Resume Header -->
      <div class="text-center mb-12 animate-fade-in">
        <h1 class="text-4xl lg:text-5xl font-light text-white mb-2">
          Ryan Clayton
        </h1>
        <p class="text-xl text-purple-400 mb-4">
          Senior Web Development Manager
        </p>
        <div class="flex justify-center gap-6 text-sm text-gray-400 font-light">
          <span>Austin, TX</span>
          <span>|</span>
          <a href="mailto:ryanclayton78@gmail.com" class="hover:text-white transition-colors">ryanclayton78@gmail.com</a>
          <span>|</span>
          <a href="https://linkedin.com/in/ryan-clayton-atx" class="hover:text-white transition-colors">LinkedIn</a>
          <span>|</span>
          <a href="https://github.com/feverdreaminteractive" class="hover:text-white transition-colors">GitHub</a>
        </div>
      </div>

      <!-- Professional Summary -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-2xl font-light text-white mb-4">Professional Summary</h2>
        <p class="text-gray-300 leading-relaxed font-light">
          Senior Web Development Manager with 12+ years of experience leading technical teams and building scalable platforms across fintech, legaltech, and AI-powered solutions. Expert in enterprise-level migrations, zero-downtime deployments, and modern Jamstack architectures. Proven track record of integrating cutting-edge AI technologies including Claude AI for conversational business intelligence and automation.
        </p>
      </div>

      <!-- Experience Timeline -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-2xl font-light text-white mb-8 flex items-center">
          <svg class="w-6 h-6 mr-3 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
          </svg>
          Professional Experience
        </h2>

        <div class="space-y-8">
          <!-- Current Position -->
          <div class="relative pl-8">
            <div class="absolute left-0 top-0 w-4 h-4 bg-purple-500 rounded-full"></div>
            <div class="absolute left-2 top-4 w-0.5 h-full bg-white/10"></div>

            <div class="bg-gradient-to-r from-purple-900/20 to-blue-900/20 rounded-lg p-6 border border-white/10">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <h3 class="text-xl font-normal text-white">Senior Web Development Manager</h3>
                <span class="text-sm font-light text-purple-400 bg-purple-900/30 px-3 py-1 rounded-full">2020 - Present</span>
              </div>
              <p class="text-gray-400 font-light mb-3">Leading Technical Innovation & Enterprise Operations</p>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Led enterprise rebrand across 7 web properties with zero downtime
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Architected modern Jamstack solutions using Vue.js, React, and Astro
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Integrated Claude AI for conversational business intelligence and automation
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Managed technical teams and implemented agile development processes
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Designed CI/CD pipelines using CircleCI and GitHub Actions (60% deployment time reduction)
                </li>
              </ul>
            </div>
          </div>

          <!-- Previous Position -->
          <div class="relative pl-8">
            <div class="absolute left-0 top-0 w-4 h-4 bg-gray-600 rounded-full"></div>
            <div class="absolute left-2 top-4 w-0.5 h-full bg-white/10"></div>

            <div class="bg-white/5 rounded-lg p-6 border border-white/10">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <h3 class="text-lg font-normal text-white">Full Stack Developer</h3>
                <span class="text-sm font-light text-gray-400 bg-white/10 px-3 py-1 rounded-full">2018 - 2020</span>
              </div>
              <p class="text-gray-400 font-light mb-3">Fintech & Legaltech Platform Development</p>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Built scalable web applications with Node.js, React, and Vue.js
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Developed marketing automation integrations (25% lead conversion increase)
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Implemented AWS infrastructure solutions for high-availability applications
                </li>
              </ul>
            </div>
          </div>

          <!-- Earlier Experience -->
          <div class="relative pl-8">
            <div class="absolute left-0 top-0 w-4 h-4 bg-gray-300 rounded-full"></div>

            <div class="bg-white/5 rounded-lg p-6 border border-white/10">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <h3 class="text-lg font-normal text-white">Web Developer</h3>
                <span class="text-sm font-light text-gray-400 bg-white/10 px-3 py-1 rounded-full">2015 - 2018</span>
              </div>
              <p class="text-gray-400 font-light mb-3">Foundation Building & Core Development</p>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Mastered JavaScript, HTML5/CSS3, and modern web development practices
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Built responsive websites for various industries
                </li>
                <li class="flex items-start">
                  <svg class="w-4 h-4 mr-2 mt-0.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Gained expertise in CMS platforms and SEO optimization
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Key Achievements -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-2xl font-light text-white mb-8 flex items-center">
          <svg class="w-6 h-6 mr-3 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
          </svg>
          Key Achievements
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="text-center p-4">
            <div class="text-3xl font-light text-purple-400 mb-2">7</div>
            <p class="text-sm text-gray-400">Web Properties Rebranded</p>
          </div>
          <div class="text-center p-4">
            <div class="text-3xl font-light text-purple-400 mb-2">0</div>
            <p class="text-sm text-gray-400">Downtime During Migration</p>
          </div>
          <div class="text-center p-4">
            <div class="text-3xl font-light text-purple-400 mb-2">60%</div>
            <p class="text-sm text-gray-400">Deployment Time Reduction</p>
          </div>
          <div class="text-center p-4">
            <div class="text-3xl font-light text-purple-400 mb-2">12+</div>
            <p class="text-sm text-gray-400">Years Experience</p>
          </div>
        </div>
      </div>

      <!-- Download Resume Button -->
      <div class="text-center mt-8">
        <a
          href="/Ryan_Clayton_Resume.pdf"
          download="Ryan_Clayton_Resume.pdf"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black rounded-lg hover:bg-gray-100 transition-all font-medium shadow-lg hover:shadow-xl hover:scale-105"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
          </svg>
          Download PDF Resume
        </a>
      </div>

    </div>
  </main>
</Layout>

<style>
  /* Grid pattern background */
  .bg-grid-pattern {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
  }
</style>