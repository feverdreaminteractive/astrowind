---
import Layout from '../layouts/Layout.astro';
import LinkList from '../components/LinkList.astro';
---

<Layout showNavigation={true}>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-black to-blue-900/20"></div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <!-- Projects Header -->
      <div class="text-center mb-12 animate-fade-in">
        <h1 class="text-4xl lg:text-5xl font-light text-white mb-4">
          Portfolio & Projects
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto font-light">
          Explore my full portfolio of web applications, AI projects, and professional work. Each project showcases different aspects of modern web development and AI integration.
        </p>
      </div>

      <!-- Featured Projects -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-2xl font-light text-white mb-8 flex items-center">
          <svg class="w-6 h-6 mr-3 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h4a1 1 0 010 2H6.414l2.293 2.293a1 1 0 01-1.414 1.414L5 6.414V8a1 1 0 01-2 0V4zm9 1a1 1 0 010-2h4a1 1 0 011 1v4a1 1 0 01-2 0V6.414l-2.293 2.293a1 1 0 11-1.414-1.414L13.586 5H12zm-9 7a1 1 0 012 0v1.586l2.293-2.293a1 1 0 111.414 1.414L6.414 15H8a1 1 0 010 2H4a1 1 0 01-1-1v-4zm13-1a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 010-2h1.586l-2.293-2.293a1 1 0 111.414-1.414L15.586 13V12a1 1 0 011-1z" clip-rule="evenodd"></path>
          </svg>
          Featured Projects
        </h2>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <!-- GTM Sales Dashboard -->
          <div class="bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-xl p-6 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-purple-600/40 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-normal text-white">GTM Sales Dashboard</h3>
                <p class="text-sm text-gray-400">AI Sales Operations</p>
              </div>
            </div>
            <p class="text-gray-300 text-sm mb-4">
              AI-powered sales operations dashboard with conversational business intelligence. Claude AI integration for natural language lead analysis, content generation, and pipeline insights.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">React</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Claude AI</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Next.js</span>
            </div>
          </div>

          <!-- Sales Intel AI Extension -->
          <div class="bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-xl p-6 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-purple-600/40 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M9 3a1 1 0 012 0v5.5a.5.5 0 001 0V4a1 1 0 112 0v4.5a.5.5 0 001 0V6a1 1 0 112 0v6a5 5 0 01-10 0V3z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-normal text-white">Sales Intel AI Extension</h3>
                <p class="text-sm text-gray-400">Chrome Extension</p>
              </div>
            </div>
            <p class="text-gray-300 text-sm mb-4">
              Chrome extension for AI-powered prospect research with Claude integration. Automatically analyzes LinkedIn profiles and company data to generate sales insights.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Chrome API</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Claude AI</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">JavaScript</span>
            </div>
          </div>

          <!-- Portfolio Website -->
          <div class="bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-xl p-6 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-purple-600/40 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-normal text-white">AI Portfolio Website</h3>
                <p class="text-sm text-gray-400">This Site</p>
              </div>
            </div>
            <p class="text-gray-300 text-sm mb-4">
              Modern portfolio website built with Astro, featuring an AI career assistant powered by Claude AI. Demonstrates modern web development practices and AI integration.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Astro</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">React</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Tailwind</span>
            </div>
          </div>

          <!-- Fever Dream Screen -->
          <div class="bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-xl p-6 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="flex items-center mb-4">
              <img
                src="/fever-dream-screen-icon.png"
                alt="Fever Dream Screen icon"
                class="w-12 h-12 rounded-lg"
                width="48"
                height="48"
              />
              <div class="ml-4">
                <h3 class="text-lg font-normal text-white">Fever Dream Screen</h3>
                <p class="text-sm text-gray-400">macOS Screen Saver</p>
              </div>
            </div>
            <p class="text-gray-300 text-sm mb-4">
              A moiré visualizer that reacts live to whatever's playing out of your speakers — captured via Core Audio's process-tap API, rendered in a custom Metal shader.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Swift</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Metal</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Core Audio</span>
            </div>
            <a
              href="/fever-dream-screen"
              class="inline-flex items-center gap-2 text-sm text-white bg-white/10 hover:bg-white/20 border border-white/10 hover:border-white/20 rounded-lg px-3 py-2 transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
              Download Screen Saver
            </a>
          </div>
        </div>
      </div>

      <!-- All Projects -->
      <div class="w-full max-w-2xl mx-auto">
        <LinkList />
      </div>

    </div>
  </main>
</Layout>