---
import Layout from '../layouts/Layout.astro';
import { SCREENSAVER_CATALOG } from '../data/screensaver-catalog';

const steps = [
  {
    title: 'Download it',
    body: 'Click a download button below. Everything here is signed with a Developer ID certificate and notarized by Apple, so Gatekeeper won\'t show any "unidentified developer" warning.',
  },
  {
    title: 'Open the .saver file',
    body: 'Safari unzips it automatically — find it in your Downloads folder (or the browser\'s download tray) and double-click it.',
  },
  {
    title: 'It installs itself',
    body: 'Double-clicking installs it to ~/Library/Screen Savers and opens System Settings straight to the Screen Saver pane with it already selected.',
  },
];
---

<Layout
  title="Downloads | Ryan Clayton"
  description="Screen savers and other downloadable projects."
  showNavigation={true}
>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-black to-blue-900/20"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <!-- Header -->
      <div class="text-center mb-8 animate-fade-in">
        <h1 class="text-4xl lg:text-5xl font-light text-white mb-4">Downloads</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto font-light">
          Screen savers and other things you can actually install and run.
        </p>
      </div>

      <!-- Photosensitivity warning -->
      <div class="flex items-start gap-2 text-left bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-12">
        <svg class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <p class="text-sm text-amber-200/90 leading-relaxed">
          <strong class="font-medium text-amber-100">Photosensitivity warning:</strong> these
          patterns include rapid flashing, strobing, and high-contrast pulsing — especially Bloom, Hypno, and Shatter.
          If you or anyone in your household has photosensitive epilepsy or a seizure disorder, use caution
          or skip these.
        </p>
      </div>

      <!-- Fever.Dream iOS/Mac/Vision app -->
      <div class="bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-xl p-6 border border-white/10 hover:border-white/20 transition-all duration-300 mb-12">
        <div class="flex items-center mb-4">
          <div class="w-12 h-12 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
            <i class="fab fa-app-store text-2xl text-white"></i>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-normal text-white">Fever.Dream</h3>
            <p class="text-sm text-gray-400">iPhone &middot; Mac &middot; Apple Vision</p>
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          Turn your camera into a portal of hypnotic visual chaos — real-time,
          audio-reactive video effects with zero lag, an intuitive crossfader
          for blending them, and one-tap recording to share what you make.
        </p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">iOS 17+</span>
          <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">macOS 14+ (Apple Silicon)</span>
          <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">visionOS 1.0+</span>
        </div>
        <a
          href="https://apps.apple.com/us/app/fever-dream/id6754286952"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-white bg-white/10 hover:bg-white/20 border border-white/10 hover:border-white/20 rounded-lg px-3 py-2 transition-all"
        >
          <i class="fab fa-app-store"></i>
          View on the App Store
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-12">
        {SCREENSAVER_CATALOG.map((entry) => (
          <div class="bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-xl p-6 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="flex items-center mb-4">
              <img
                src={`/${entry.slug}-icon.png`}
                alt={`${entry.name} icon`}
                class="w-12 h-12 rounded-lg"
                width="48"
                height="48"
              />
              <div class="ml-4">
                <h3 class="text-lg font-normal text-white">{entry.name}</h3>
                <p class="text-sm text-gray-400">macOS Screen Saver</p>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Swift</span>
              <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Metal</span>
            </div>
            <a
              href={`/downloads/${entry.zipFile}`}
              download
              class="inline-flex items-center gap-2 text-sm text-white bg-white/10 hover:bg-white/20 border border-white/10 hover:border-white/20 rounded-lg px-3 py-2 transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
              Download for macOS
            </a>
          </div>
        ))}
      </div>

      <!-- Install steps -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-xl font-light text-white mb-6">Installing one</h2>
        <ol class="space-y-6">
          {steps.map((step, i) => (
            <li class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-purple-600/40 text-white text-sm flex items-center justify-center font-medium">
                {i + 1}
              </div>
              <div>
                <h3 class="text-white font-normal mb-1">{step.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Trust / verification -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-xl font-light text-white mb-4">Why you can trust these downloads</h2>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          Everything on this page is built and signed by me, Ryan Clayton, under my own Apple
          Developer ID (Team ID <code class="text-gray-300">AWLLM3Q8GW</code>). Each is also
          notarized: Apple independently scanned the exact binary you're downloading and issued it
          a ticket, which is stapled to the file so Gatekeeper can verify it offline. You don't have
          to take my word for any of that — check it yourself after downloading:
        </p>
        <pre class="bg-black/60 border border-white/10 rounded-lg p-4 text-sm text-gray-300 overflow-x-auto"><code>spctl -a -vv -t install ~/Downloads/&lt;Name&gt;.saver</code></pre>
        <p class="text-gray-400 text-sm leading-relaxed mt-4">
          That should print <code class="text-gray-300">source=Notarized Developer ID</code> and
          <code class="text-gray-300">origin=Developer ID Application: Ryan Clayton (AWLLM3Q8GW)</code>.
          If it doesn't say exactly that, don't run it. The source is also public if you'd rather
          read the code than trust a signature:
        </p>
        <a
          href="https://github.com/feverdreaminteractive/AudioMoire"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-4 text-sm text-gray-400 hover:text-white transition-colors"
        >
          View source on GitHub &rarr;
        </a>
      </div>

    </div>
  </main>
</Layout>
