---
import Layout from '../layouts/Layout.astro';
import { SCREENSAVER_CATALOG } from '../data/screensaver-catalog';

// Add future screen savers / downloads here — each renders as a card below.
const DOWNLOADS = [
  {
    name: 'Drippy',
    subtitle: 'macOS Screen Saver',
    icon: '/drippy-icon.png',
    tags: ['Swift', 'Metal', 'Core Audio'],
    href: '/fever-dream-screen',
    cta: 'View & Download',
  },
  ...SCREENSAVER_CATALOG.map((entry) => ({
    name: entry.name,
    subtitle: 'macOS Screen Saver',
    icon: `/${entry.slug}-icon.png`,
    tags: ['Swift', 'Metal', 'Core Audio'],
    href: `/downloads/${entry.slug}`,
    cta: 'View & Download',
  })),
];
---

<Layout
  title="Downloads | Ryan Clayton"
  description="Screen savers and other downloadable projects."
  showNavigation={true}
>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-black to-blue-900/20"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <!-- Header -->
      <div class="text-center mb-12 animate-fade-in">
        <h1 class="text-4xl lg:text-5xl font-light text-white mb-4">Downloads</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto font-light">
          Screen savers and other things you can actually install and run.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {DOWNLOADS.map((item) => (
          <div class="bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-xl p-6 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="flex items-center mb-4">
              <img
                src={item.icon}
                alt={`${item.name} icon`}
                class="w-12 h-12 rounded-lg"
                width="48"
                height="48"
              />
              <div class="ml-4">
                <h3 class="text-lg font-normal text-white">{item.name}</h3>
                <p class="text-sm text-gray-400">{item.subtitle}</p>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 mb-4">
              {item.tags.map((tag) => (
                <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">{tag}</span>
              ))}
            </div>
            <a
              href={item.href}
              class="inline-flex items-center gap-2 text-sm text-white bg-white/10 hover:bg-white/20 border border-white/10 hover:border-white/20 rounded-lg px-3 py-2 transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
              {item.cta}
            </a>
          </div>
        ))}
      </div>

    </div>
  </main>
</Layout>
