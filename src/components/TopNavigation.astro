---
// Top navigation component - Render.com inspired
const currentPath = Astro.url.pathname;

// Helper function to check if a path is active
const isActive = (href: string) => {
  // For debugging in production
  if (typeof window === 'undefined') {
    console.log(`Server: Checking ${href} against ${currentPath}`);
  }

  // Handle trailing slashes and exact match
  const normalizedCurrent = currentPath.endsWith('/') && currentPath !== '/'
    ? currentPath.slice(0, -1)
    : currentPath;
  const normalizedHref = href.endsWith('/') && href !== '/'
    ? href.slice(0, -1)
    : href;

  return normalizedCurrent === normalizedHref;
};

const navItems: { name: string; href: string }[] = [];

const aiTools = [
  {
    name: 'AI Builder',
    href: '/builder',
    description: 'Generate a working website from a prompt, live in the browser.',
    icon: 'M13 3L4 14h6l-1 7 9-11h-6l1-7z',
  },
  {
    name: 'Shader Lab',
    href: '/shader-lab',
    description: 'Write and preview GLSL shaders with AI-assisted generation.',
    icon: 'M8 9l-4 3 4 3M16 9l4 3-4 3',
  },
  {
    name: 'Stack Auditor',
    href: '/stack-audit',
    description: "Scan any site's martech stack and get an AI-powered audit.",
    icon: 'search', // rendered specially below (circle + line, not a single path)
  },
  {
    name: 'AEO Checker',
    href: '/aeo-check',
    description: 'See what AI answer engines actually say about a brand.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  },
];

const isAiToolActive = aiTools.some((tool) => isActive(tool.href));
