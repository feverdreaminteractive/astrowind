---
// Top navigation component - Render.com inspired
const currentPath = Astro.url.pathname;

// Helper function to check if a path is active
const isActive = (href: string) => {
  // For debugging in production
  if (typeof window === 'undefined') {
    console.log(`Server: Checking ${href} against ${currentPath}`);
  }

  // Handle trailing slashes and exact match
  const normalizedCurrent = currentPath.endsWith('/') && currentPath !== '/'
    ? currentPath.slice(0, -1)
    : currentPath;
  const normalizedHref = href.endsWith('/') && href !== '/'
    ? href.slice(0, -1)
    : href;

  return normalizedCurrent === normalizedHref;
};

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/experience' },  // Consolidated experience/skills/resume
  { name: 'AI Builder', href: '/builder' },
  { name: 'Shader Lab', href: '/shader-lab' },
  { name: 'Roadmap', href: '/roadmap' },
];
