<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- Remove all glow styles -->

<script>
  // Store state globally to prevent duplicate listeners
  let mobileMenuInitialized = false;

  // Function to toggle mobile menu
  function toggleMobileMenu() {
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu) {
      mobileMenu.classList.toggle('hidden');
    }
  }

  // Function to close mobile menu
  function closeMobileMenu() {
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu) {
      mobileMenu.classList.add('hidden');
    }
  }

  // Function to handle clicks outside menu
  function handleOutsideClick(e) {
    const mobileMenu = document.getElementById('mobile-menu');
    const menuButton = document.getElementById('mobile-menu-button');
    if (mobileMenu && menuButton &&
        !mobileMenu.contains(e.target) &&
        !menuButton.contains(e.target)) {
      closeMobileMenu();
    }
  }

  // Function to initialize navigation
  function initializeNavigation() {
    const currentPath = window.location.pathname;

    // Update desktop nav items
    document.querySelectorAll('.nav-item').forEach(link => {
      const href = link.getAttribute('href');
      const isActive = (href === '/' && currentPath === '/') ||
                       (href !== '/' && currentPath === href);

      link.classList.toggle('text-white', isActive);
      link.classList.toggle('font-medium', isActive);
      link.classList.toggle('text-gray-400', !isActive);
    });

    // Update mobile nav items
    document.querySelectorAll('.mobile-nav-item').forEach(link => {
      const href = link.getAttribute('href');
      const isActive = (href === '/' && currentPath === '/') ||
                       (href !== '/' && currentPath === href);

      link.classList.toggle('text-white', isActive);
      link.classList.toggle('font-medium', isActive);
      link.classList.toggle('text-gray-400', !isActive);
    });

    // Setup mobile menu only once with event delegation
    if (!mobileMenuInitialized) {
      // Use event delegation for menu button
      document.addEventListener('click', (e) => {
        if (e.target.closest('#mobile-menu-button')) {
          e.stopPropagation();
          e.preventDefault();
          toggleMobileMenu();
        }
      });

      // Use event delegation for outside clicks
      document.addEventListener('click', handleOutsideClick);

      // Use event delegation for menu links
      document.addEventListener('click', (e) => {
        if (e.target.closest('#mobile-menu a')) {
          // Small delay to allow navigation
          setTimeout(closeMobileMenu, 50);
        }
      });

      mobileMenuInitialized = true;
    }
  }

  // Initialize on first load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeNavigation);
  } else {
    initializeNavigation();
  }

  // Reinitialize navigation state after Astro navigation
  document.addEventListener('astro:after-swap', () => {
    initializeNavigation();
    closeMobileMenu(); // Always close menu after navigation
  });

  // Also listen for page show (back/forward navigation)
  window.addEventListener('pageshow', () => {
    initializeNavigation();
  });
</script>

