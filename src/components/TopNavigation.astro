---
// Top navigation component - Render.com inspired
const currentPath = Astro.url.pathname;

// Helper function to check if a path is active
const isActive = (href: string) => {
  // Exact match check
  return currentPath === href;
};

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Experience', href: '/experience' },
  { name: 'Skills', href: '/skills' },
  { name: 'AI Builder', href: '/builder' },
];

// Direct download link for resume
const resumeLink = {
  name: 'Resume',
  href: '/Ryan_Clayton_Resume.pdf',
  download: true
};
---

<header class="fixed top-0 left-0 right-0 z-50 bg-black/95 backdrop-blur-sm border-b border-white/10 overflow-x-hidden">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Left: Logo -->
      <div class="flex items-center space-x-10">
        <a href="/" class="flex items-center space-x-2 sm:space-x-3">
          <img
            src="https://github.com/ryanclayton.png"
            alt="Ryan Clayton"
            class="w-8 sm:w-10 h-8 sm:h-10 rounded-full border border-white/20"
          />
          <span class="hidden sm:inline text-white font-normal text-lg">Ryan Clayton</span>
        </a>

        <!-- Main Navigation -->
        <div class="hidden md:flex items-center space-x-8">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`relative text-sm transition-colors ${
                isActive(item.href)
                  ? 'text-white font-medium'
                  : 'text-gray-400 hover:text-white'
              }`}
            >
              {item.name}
              {isActive(item.href) && (
                <span class="absolute -bottom-[21px] left-0 right-0 h-[2px] bg-white"></span>
              )}
            </a>
          ))}
          <!-- Resume Download Link -->
          <a
            href={resumeLink.href}
            download="Ryan_Clayton_Resume.pdf"
            class="text-sm text-gray-400 hover:text-white transition-colors flex items-center gap-1"
          >
            {resumeLink.name}
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: CTAs -->
      <div class="flex items-center space-x-4">
        <!-- Social Links -->
        <a
          href="https://apps.apple.com/us/app/fever-dream/id6754286952"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex text-gray-400 hover:text-white transition-colors"
          title="App Store"
        >
          <i class="fab fa-app-store text-lg"></i>
        </a>
        <a
          href="https://www.linkedin.com/in/ryan-clayton-34676a25/"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex text-gray-400 hover:text-white transition-colors"
          title="LinkedIn"
        >
          <i class="fab fa-linkedin text-lg"></i>
        </a>
        <a
          href="https://github.com/feverdreaminteractive"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex text-gray-400 hover:text-white transition-colors"
          title="GitHub"
        >
          <i class="fab fa-github text-lg"></i>
        </a>
        <a
          href="/hire-me"
          class={`inline-flex items-center px-4 h-16 text-sm transition-all ${
            isActive('/hire-me')
              ? 'text-white bg-gray-800 hover:bg-gray-700'
              : 'text-black bg-white hover:bg-gray-100'
          }`}
        >
          Contact
        </a>

        <!-- Mobile menu button -->
        <button
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2 text-gray-400 hover:text-white"
          id="mobile-menu-button"
        >
          <span class="sr-only">Open menu</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div class="hidden md:hidden" id="mobile-menu">
    <div class="px-4 pt-2 pb-3 space-y-1 bg-black border-t border-white/10">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-3 py-2 text-base ${
            isActive(item.href)
              ? 'text-white font-medium'
              : 'text-gray-400 hover:text-white'
          }`}
        >
          {item.name}
        </a>
      ))}
      <!-- Resume Download Link (Mobile) -->
      <a
        href={resumeLink.href}
        download="Ryan_Clayton_Resume.pdf"
        class="block px-3 py-2 text-base text-gray-400 hover:text-white flex items-center gap-2"
      >
        {resumeLink.name}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
        </svg>
      </a>
      <div class="pt-2 border-t border-white/10">
        <div class="flex items-center justify-center space-x-6 py-3">
          <a
            href="https://apps.apple.com/us/app/fever-dream/id6754286952"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white"
            title="App Store"
          >
            <i class="fab fa-app-store text-xl"></i>
          </a>
          <a
            href="https://www.linkedin.com/in/ryan-clayton-34676a25/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white"
            title="LinkedIn"
          >
            <i class="fab fa-linkedin text-xl"></i>
          </a>
          <a
            href="https://github.com/feverdreaminteractive"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white"
            title="GitHub"
          >
            <i class="fab fa-github text-xl"></i>
          </a>
        </div>
        <a
          href="/hire-me"
          class="block px-3 py-2 text-base text-black bg-white text-center mt-2"
        >
          Contact
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (menuButton && mobileMenu) {
      // Toggle menu on button click
      menuButton.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenu.classList.toggle('hidden');
      });

      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target)) {
          mobileMenu.classList.add('hidden');
        }
      });

      // Close menu when clicking on any link inside the menu
      const menuLinks = mobileMenu.querySelectorAll('a');
      menuLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
        });
      });

      // Close menu on page navigation (Astro View Transitions)
      document.addEventListener('astro:after-swap', () => {
        mobileMenu.classList.add('hidden');
      });
    }
  });

  // Re-initialize after Astro page transitions
  document.addEventListener('astro:after-swap', () => {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (menuButton && mobileMenu) {
      // Ensure menu is hidden after navigation
      mobileMenu.classList.add('hidden');
    }
  });
</script>

