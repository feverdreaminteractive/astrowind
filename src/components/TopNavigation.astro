<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- Remove all glow styles -->

<script>
  // Store state globally to prevent duplicate listeners
  let mobileMenuInitialized = false;

  // Function to toggle mobile menu
  function toggleMobileMenu() {
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu) {
      mobileMenu.classList.toggle('hidden');
    }
  }

  // Function to close mobile menu
  function closeMobileMenu() {
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu) {
      mobileMenu.classList.add('hidden');
    }
  }

  // Function to handle clicks outside menu
  function handleOutsideClick(e) {
    const mobileMenu = document.getElementById('mobile-menu');
    const menuButton = document.getElementById('mobile-menu-button');
    if (mobileMenu && menuButton &&
        !mobileMenu.contains(e.target) &&
        !menuButton.contains(e.target)) {
      closeMobileMenu();
    }
  }

  const AI_TOOL_PATHS = ['/builder', '/shader-lab', '/stack-audit', '/aeo-check'];
  let aiMenuCloseTimer = null;

  function openAiMenu() {
    clearTimeout(aiMenuCloseTimer);
    const panel = document.getElementById('ai-menu-panel');
    const button = document.getElementById('ai-menu-button');
    const chevron = document.getElementById('ai-menu-chevron');
    const backdrop = document.getElementById('ai-menu-backdrop');
    if (panel) panel.classList.remove('hidden');
    if (button) button.setAttribute('aria-expanded', 'true');
    if (chevron) chevron.classList.add('rotate-180');
    if (backdrop) backdrop.classList.remove('opacity-0', 'pointer-events-none');
  }

  function closeAiMenu() {
    const panel = document.getElementById('ai-menu-panel');
    const button = document.getElementById('ai-menu-button');
    const chevron = document.getElementById('ai-menu-chevron');
    const backdrop = document.getElementById('ai-menu-backdrop');
    if (panel) panel.classList.add('hidden');
    if (button) button.setAttribute('aria-expanded', 'false');
    if (chevron) chevron.classList.remove('rotate-180');
    if (backdrop) backdrop.classList.add('opacity-0', 'pointer-events-none');
  }

  function scheduleCloseAiMenu() {
    clearTimeout(aiMenuCloseTimer);
    aiMenuCloseTimer = setTimeout(closeAiMenu, 150);
  }

  // Function to initialize navigation
  function initializeNavigation() {
    const currentPath = window.location.pathname;

    // Update desktop nav items
    document.querySelectorAll('.nav-item').forEach(link => {
      const href = link.getAttribute('href');
      const isActive = (href === '/' && currentPath === '/') ||
                       (href !== '/' && currentPath === href);

      link.classList.toggle('text-white', isActive);
      link.classList.toggle('font-medium', isActive);
      link.classList.toggle('text-gray-400', !isActive);
    });

    // Update AI Tools trigger active state (any of the tool pages)
    const aiMenuButton = document.getElementById('ai-menu-button');
    if (aiMenuButton) {
      const normalizedCurrent = currentPath.endsWith('/') && currentPath !== '/' ? currentPath.slice(0, -1) : currentPath;
      const isAiActive = AI_TOOL_PATHS.includes(normalizedCurrent);
      aiMenuButton.classList.toggle('text-white', isAiActive);
      aiMenuButton.classList.toggle('font-medium', isAiActive);
      aiMenuButton.classList.toggle('text-gray-400', !isAiActive);
    }
    closeAiMenu();

    // Update mobile nav items
    document.querySelectorAll('.mobile-nav-item').forEach(link => {
      const href = link.getAttribute('href');
      const isActive = (href === '/' && currentPath === '/') ||
                       (href !== '/' && currentPath === href);

      link.classList.toggle('text-white', isActive);
      link.classList.toggle('font-medium', isActive);
      link.classList.toggle('text-gray-400', !isActive);
    });

    // Setup mobile menu only once with event delegation
    if (!mobileMenuInitialized) {
      // Use event delegation for menu button
      document.addEventListener('click', (e) => {
        if (e.target.closest('#mobile-menu-button')) {
          e.stopPropagation();
          e.preventDefault();
          toggleMobileMenu();
        }
      });

      // Use event delegation for outside clicks
      document.addEventListener('click', handleOutsideClick);

      // Use event delegation for menu links
      document.addEventListener('click', (e) => {
        if (e.target.closest('#mobile-menu a')) {
          // Small delay to allow navigation
          setTimeout(closeMobileMenu, 50);
        }
      });

      // AI Tools mega menu — hover to open/close (desktop pointer), with a
      // short close delay so moving from the trigger to the panel doesn't
      // flicker it shut.
      document.addEventListener('mouseover', (e) => {
        if (e.target.closest('#ai-menu-wrapper')) openAiMenu();
      });
      document.addEventListener('mouseout', (e) => {
        const wrapper = document.getElementById('ai-menu-wrapper');
        if (wrapper && wrapper.contains(e.target) && !wrapper.contains(e.relatedTarget)) {
          scheduleCloseAiMenu();
        }
      });

      // Click always opens (not a toggle) — needed for touch devices, which
      // don't hover. A toggle would fight the hover handler: moving the
      // mouse onto the button already opens it via 'mouseover', so a click
      // right after would immediately close what hover just opened. Closing
      // is handled by outside-click, Escape, and mouseout instead.
      document.addEventListener('click', (e) => {
        if (e.target.closest('#ai-menu-button')) {
          e.stopPropagation();
          e.preventDefault();
          openAiMenu();
        }
      });

      // Close on outside click, on Escape, and after picking a link
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#ai-menu-wrapper')) closeAiMenu();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAiMenu();
      });
      document.addEventListener('click', (e) => {
        if (e.target.closest('#ai-menu-panel a')) closeAiMenu();
      });

      mobileMenuInitialized = true;
    }
  }

  // Initialize on first load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeNavigation);
  } else {
    initializeNavigation();
  }

  // Reinitialize navigation state after Astro navigation
  document.addEventListener('astro:after-swap', () => {
    initializeNavigation();
    closeMobileMenu(); // Always close menu after navigation
  });

  // Also listen for page show (back/forward navigation)
  window.addEventListener('pageshow', () => {
    initializeNavigation();
  });
</script>

