---
export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<picture class={`hdr-logo ${className}`}>
  <!-- HDR source with glow for capable displays -->
  <source
    srcset="/logoRC_hdr_mark_glows.jpg"
    type="image/jpeg"
    media="(color-gamut: p3)"
  />
  <source
    srcset="/logoRC_hdr_mark_feathered.jpg"
    type="image/jpeg"
    media="(color-gamut: rec2020)"
  />
  <!-- Fallback SDR image -->
  <img
    src="/logoRC_sdr_reference.jpg"
    alt="Ryan Clayton Logo"
    class="logo-img"
    loading="eager"
  />
</picture>

<style>
  .hdr-logo {
    display: inline-block;
    position: relative;
  }

  .logo-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Enhanced glow for HDR displays */
  @media (color-gamut: p3) {
    .hdr-logo::after {
      content: '';
      position: absolute;
      inset: -30%;
      background: radial-gradient(
        circle at center,
        color(display-p3 1 0.5 0.2 / 0.4),
        color(display-p3 0.9 0.3 0.6 / 0.2),
        transparent 60%
      );
      filter: blur(30px);
      z-index: -1;
      animation: hdr-pulse 4s ease-in-out infinite;
      pointer-events: none;
      mix-blend-mode: screen;
    }
  }

  @media (color-gamut: rec2020) {
    .hdr-logo::after {
      background: radial-gradient(
        circle at center,
        color(rec2020 1 0.4 0.1 / 0.5),
        color(rec2020 0.95 0.2 0.7 / 0.3),
        transparent 50%
      );
      filter: blur(40px) saturate(1.5);
    }
  }

  @keyframes hdr-pulse {
    0%, 100% {
      transform: scale(1) rotate(0deg);
      opacity: 0.7;
    }
    25% {
      transform: scale(1.2) rotate(45deg);
      opacity: 1;
    }
    50% {
      transform: scale(1.1) rotate(90deg);
      opacity: 0.85;
    }
    75% {
      transform: scale(1.15) rotate(135deg);
      opacity: 0.95;
    }
  }

  /* Fallback for standard displays */
  @supports not (color: color(display-p3 1 0 0)) {
    .hdr-logo::after {
      content: '';
      position: absolute;
      inset: -20%;
      background: radial-gradient(
        circle at center,
        rgba(255, 127, 50, 0.3),
        rgba(230, 80, 180, 0.15),
        transparent 60%
      );
      filter: blur(25px);
      z-index: -1;
      animation: hdr-pulse 4s ease-in-out infinite;
      pointer-events: none;
    }
  }
</style>