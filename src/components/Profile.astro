---
import { Image } from 'astro:assets';
import { PROFILE_CONFIG } from '../consts';

interface Props {
  name?: string;
  title?: string;
  bio?: string;
  image?: ImageMetadata;
}

const {
  name = PROFILE_CONFIG.name,
  title = PROFILE_CONFIG.title,
  bio = PROFILE_CONFIG.bio,
  image = PROFILE_CONFIG.avatar
} = Astro.props;
---

<div class="text-center mb-4">
  <!-- Profile image with minimal styling -->
  <div class="relative inline-block mb-3">
    <Image
      src={image}
      alt={name}
      width={80}
      height={80}
      densities={[1.5, 2]}
      quality={90}
      loading="eager"
      class="w-16 h-16 rounded-full object-cover border border-gray-200"
    />
  </div>

  <!-- Text content with elegant typography -->
  <div>
    <h1 class="text-3xl font-serif font-bold text-gray-900 mb-0.5" style="font-family: 'Playfair Display', serif;">
      {name}
    </h1>
    <p class="text-sm text-gray-600 font-light">
      {title}
    </p>
  </div>
</div>

<style>
  @keyframes gradient-xy {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .animate-gradient-xy {
    background-size: 200% 200%;
    animation: gradient-xy 15s ease infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.3;
    }
  }

  .animate-pulse {
    animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
