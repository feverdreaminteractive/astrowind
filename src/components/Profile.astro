---
import { Image } from 'astro:assets';
import { PROFILE_CONFIG } from '../consts';

interface Props {
  name?: string;
  title?: string;
  bio?: string;
  image?: ImageMetadata;
}

const {
  name = PROFILE_CONFIG.name,
  title = PROFILE_CONFIG.title,
  bio = PROFILE_CONFIG.bio,
  image = PROFILE_CONFIG.avatar
} = Astro.props;
---

<div class="text-center mb-4">
  <!-- Profile image with minimal styling -->
  <div class="relative inline-block mb-3" transition:animate="fade">
    <Image
      src={image}
      alt={name}
      width={80}
      height={80}
      densities={[1.5, 2]}
      quality={90}
      loading="eager"
      class="w-16 h-16 rounded-full object-cover border border-gray-200"
      transition:name="profile-image"
    />
  </div>

  <!-- Text content with elegant typography -->
  <div transition:animate="slide">
    <h1 class="text-3xl font-serif font-bold text-gray-900 mb-0.5" style="font-family: 'Playfair Display', serif;" transition:name="profile-name">
      {name}
    </h1>
    <p class="text-lg text-gray-700 mt-2" transition:name="profile-title">
      I <span class="rotating-word-container">
        <span class="rotating-word font-semibold text-gray-900">design</span>
      </span> beautiful web experiences.
    </p>
  </div>
</div>

<script>
  // Rotating words animation
  const words = ['design', 'build', 'ship', 'animate', 'prototype'];
  let currentIndex = 0;

  function rotateWord() {
    const wordElement = document.querySelector('.rotating-word');
    if (wordElement) {
      // Fade out
      wordElement.style.opacity = '0';
      wordElement.style.transform = 'translateY(-10px)';

      setTimeout(() => {
        // Change word
        currentIndex = (currentIndex + 1) % words.length;
        wordElement.textContent = words[currentIndex];

        // Fade in
        wordElement.style.opacity = '1';
        wordElement.style.transform = 'translateY(0)';
      }, 200);
    }
  }

  // Start rotation after page loads
  if (typeof window !== 'undefined') {
    setTimeout(() => {
      setInterval(rotateWord, 2500);
    }, 1000);
  }
</script>

<style>
  .rotating-word-container {
    display: inline-block;
    min-width: 100px;
    text-align: left;
  }

  .rotating-word {
    display: inline-block;
    transition: all 0.3s ease;
  }

  @keyframes gradient-xy {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .animate-gradient-xy {
    background-size: 200% 200%;
    animation: gradient-xy 15s ease infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.3;
    }
  }

  .animate-pulse {
    animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
