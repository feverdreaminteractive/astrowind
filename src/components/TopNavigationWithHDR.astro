<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- Enhanced CSS for HDR support -->
<style>
  @media (color-gamut: p3) {
    .logo-image {
      filter: saturate(1.1) contrast(1.05);
    }
  }

  @media (color-gamut: rec2020) {
    .logo-image {
      filter: saturate(1.2) contrast(1.1) brightness(1.05);
    }
  }

  @supports (color: color(display-p3 1 0 0)) {
    #logo-container {
      position: relative;
    }

    #logo-container::after {
      content: '';
      position: absolute;
      inset: -15px;
      background: radial-gradient(
        circle at center,
        color(display-p3 1 0.7 0.3 / 0.3),
        color(display-p3 0.9 0.4 0.8 / 0.15),
        transparent 60%
      );
      filter: blur(15px);
      z-index: -1;
      animation: hdr-glow 4s ease-in-out infinite;
      pointer-events: none;
    }
  }

  @keyframes hdr-glow {
    0%, 100% {
      transform: scale(1) rotate(0deg);
      opacity: 0.8;
    }
    25% {
      transform: scale(1.15) rotate(90deg);
      opacity: 1;
    }
    50% {
      transform: scale(1.05) rotate(180deg);
      opacity: 0.9;
    }
    75% {
      transform: scale(1.1) rotate(270deg);
      opacity: 0.95;
    }
  }
</style>

<script>
  import { HDRGlow } from './HDRGlow.tsx';
  import React from 'react';
  import { createRoot } from 'react-dom/client';

  // Store state globally to prevent duplicate listeners
  let mobileMenuInitialized = false;
  let hdrGlowInitialized = false;

  // Function to initialize HDR glow
  function initializeHDRGlow() {
    if (hdrGlowInitialized) return;

    const logoContainer = document.getElementById('logo-container');
    const logoImage = document.querySelector('.logo-image') as HTMLImageElement;

    if (logoContainer && logoImage && typeof window !== 'undefined') {
      // Check for HDR display support
      const supportsP3 = window.matchMedia('(color-gamut: p3)').matches;
      const supportsRec2020 = window.matchMedia('(color-gamut: rec2020)').matches;

      // Use appropriate color space
      const colorSpace = supportsRec2020 ? 'rec2020' : supportsP3 ? 'p3' : 'srgb';

      // Create React root and render HDR glow component
      const root = createRoot(logoContainer);
      root.render(
        React.createElement(HDRGlow, {
          intensity: supportsRec2020 ? 1.5 : supportsP3 ? 1.2 : 0.8,
          colorSpace: colorSpace,
          children: React.createElement('img', {
            src: logoImage.src,
            alt: logoImage.alt,
            className: logoImage.className,
          })
        })
      );

      hdrGlowInitialized = true;
    }
  }

  // Function to toggle mobile menu
  function toggleMobileMenu() {
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu) {
      mobileMenu.classList.toggle('hidden');
    }
  }

  // Function to close mobile menu
  function closeMobileMenu() {
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu) {
      mobileMenu.classList.add('hidden');
    }
  }

  // Function to handle clicks outside menu
  function handleOutsideClick(e) {
    const mobileMenu = document.getElementById('mobile-menu');
    const menuButton = document.getElementById('mobile-menu-button');
    if (mobileMenu && menuButton &&
        !mobileMenu.contains(e.target) &&
        !menuButton.contains(e.target)) {
      closeMobileMenu();
    }
  }

  // Function to initialize navigation
  function initializeNavigation() {
    const currentPath = window.location.pathname;

    // Update desktop nav items
    document.querySelectorAll('.nav-item').forEach(link => {
      const href = link.getAttribute('href');
      const isActive = (href === '/' && currentPath === '/') ||
                       (href !== '/' && currentPath === href);

      link.classList.toggle('text-white', isActive);
      link.classList.toggle('font-medium', isActive);
      link.classList.toggle('text-gray-400', !isActive);
    });

    // Update mobile nav items
    document.querySelectorAll('.mobile-nav-item').forEach(link => {
      const href = link.getAttribute('href');
      const isActive = (href === '/' && currentPath === '/') ||
                       (href !== '/' && currentPath === href);

      link.classList.toggle('text-white', isActive);
      link.classList.toggle('font-medium', isActive);
      link.classList.toggle('text-gray-400', !isActive);
    });

    // Initialize HDR glow
    initializeHDRGlow();

    // Setup mobile menu only once with event delegation
    if (!mobileMenuInitialized) {
      document.addEventListener('click', (e) => {
        if (e.target.closest('#mobile-menu-button')) {
          e.stopPropagation();
          e.preventDefault();
          toggleMobileMenu();
        }
      });

      document.addEventListener('click', handleOutsideClick);

      document.addEventListener('click', (e) => {
        if (e.target.closest('#mobile-menu a')) {
          setTimeout(closeMobileMenu, 50);
        }
      });

      mobileMenuInitialized = true;
    }
  }

  // Initialize on first load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeNavigation);
  } else {
    initializeNavigation();
  }

  // Reinitialize navigation state after Astro navigation
  document.addEventListener('astro:after-swap', () => {
    hdrGlowInitialized = false; // Reset HDR glow for new page
    initializeNavigation();
    closeMobileMenu();
  });

  // Also listen for page show (back/forward navigation)
  window.addEventListener('pageshow', () => {
    initializeNavigation();
  });
</script>