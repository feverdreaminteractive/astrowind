---
// Top navigation component with HDR glow effect
import { HDRGlow, HDRGlowCSS } from './HDRGlow.tsx';

const currentPath = Astro.url.pathname;

// Helper function to check if a path is active
const isActive = (href: string) => {
  const normalizedCurrent = currentPath.endsWith('/') && currentPath !== '/'
    ? currentPath.slice(0, -1)
    : currentPath;
  const normalizedHref = href.endsWith('/') && href !== '/'
    ? href.slice(0, -1)
    : href;

  return normalizedCurrent === normalizedHref;
};

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/experience' },
  { name: 'AI Builder', href: '/builder' },
  { name: 'Shader Lab', href: '/shader-lab' },
];
---

